# Variabili dell'AMBIENTE DI PROVA di SchieraXI (script/server/prova/LEGGIMI.md).
# prepara-prova.sh lo copia in ~/schieraxi-prova/dati/ambiente.env se manca (permessi 600). Lo leggono il servizio
# (EnvironmentFile di schieraxi-prova.service) e gli script (leggi-ambiente.sh): una riga NOME=valore, senza virgolette.
# Niente segreti qui dentro: e' un esempio nel repository pubblico. La prova non deve mai parlare con gli utenti veri ne' con i siti
# delle fonti: tutto quello che lo fa resta spento.

# Account accesi, solo con invito; dietro nginx come la produzione (indirizzo vero di chi chiede, https riconosciuto)
FANTA_MULTIUTENTE=1
FANTA_REGISTRAZIONE=invito
FANTA_PROXY=1
# Le stesse funzioni della produzione: il collaudo prova quello che vedono gli utenti
FANTA_PROFILO_FUNZIONI=completo

# Spenti: posta, lavori periodici dentro il servizio, risultati in diretta
FANTA_MAIL=spento
FANTA_PIANIFICATORE=0
FANTA_REGISTRO_GIORNATE=0
FANTA_COPIA_SCADENZA=0
FANTA_RISCALDA=0
FANTA_LIVE=0

# Spente tutte le fonti di dati esterne: i dati di calcio arrivano solo dalla copia notturna dell'archivio della produzione
FANTA_FONTE_FANTACALCIO=0
FANTA_FONTE_UNDERSTAT=0
FANTA_FONTE_FOOTBALLDATA=0
FANTA_FONTE_ESPN=0
FANTA_FONTE_SOSFANTA=0
FANTA_FONTE_FOTO=0

# Nessun canale di avvisi (FANTA_CANALE_AVVISI) e nessuna casella di posta: non vanno aggiunti.

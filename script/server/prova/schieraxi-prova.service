# Servizio systemd dell'AMBIENTE DI PROVA di SchieraXI (script/server/prova/LEGGIMI.md, passo 4.6): una seconda copia dell'app,
# con dati inventati, accanto alla produzione. Da copiare cosi' com'e' in /etc/systemd/system/schieraxi-prova.service, prendendolo
# dalla copia installata in produzione (~/fantacalcio/script/server/prova/), mai da quella della prova (che la prova puo' cambiare).
# Ascolta solo su 127.0.0.1:8001: dall'esterno ci si arriva da nginx (nginx-prova.conf.esempio).
#
# Cosa protegge (il dettaglio, con i limiti, e' nel LEGGIMI, «Cosa protegge il recinto e cosa no»):
# - gira con il suo utente di sistema, schieraxi-prova (passo 4.3), che non ha permessi sui file della produzione: il kernel non gli
#   lascia aprire /proc/<processo della produzione>/cwd, root, environ, fd (serve lo stesso utente o root);
# - ProtectHome=tmpfs: al posto di /home una cartella vuota, quindi niente casa della produzione (codice, dati, lega vera, copie,
#   chiavi), nemmeno i file leggibili da tutti;
# - ProtectSystem=strict: tutto in sola lettura tranne /srv/schieraxi-prova/app/dati e la sua /tmp privata;
# - InaccessiblePaths: non vede la chiave delle firme, il clone, lo stato degli aggiornamenti e la cartella di scambio (il '-' davanti
#   vuol dire "se c'e'"); ProtectProc=invisible: non vede i processi degli altri utenti (dove il kernel lo permette);
# - NoNewPrivileges: niente sudo ne' programmi setuid; IPAddressDeny/IPAddressAllow: parla solo con questo computer (127.0.0.1, ::1),
#   niente collegamenti verso internet;
# - memoria e processore limitati: la produzione ha la precedenza.
# Non protegge: kernel, memoria e processore in comune; le richieste all'app della produzione su 127.0.0.1:8000 (come un visitatore,
# ma senza passare da nginx).
[Unit]
Description=SchieraXI - ambiente di prova (dati inventati)
After=network-online.target
Wants=network-online.target

[Service]
User=schieraxi-prova
Group=schieraxi-prova
WorkingDirectory=/srv/schieraxi-prova/app
ExecStart=/srv/schieraxi-prova/app/.venv/bin/python -m fanta server --host 127.0.0.1 --porta 8001
Restart=on-failure
RestartSec=5
UMask=0077
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
# Variabili dell'app, qui e non in un EnvironmentFile: systemd legge quel file come root, prima del recinto, e un file in una cartella
# della prova lei lo potrebbe far puntare a quello della produzione. Non sono segrete. Mai un EnvironmentFile sotto /srv/schieraxi-prova.
# Account accesi, solo con invito; dietro nginx come la produzione (indirizzo vero di chi chiede, https riconosciuto); le stesse
# funzioni della produzione, cosi' il collaudo prova quello che vedono gli utenti
Environment=FANTA_MULTIUTENTE=1
Environment=FANTA_REGISTRAZIONE=invito
Environment=FANTA_PROXY=1
Environment=FANTA_PROFILO_FUNZIONI=completo
# spenti: posta, lavori periodici dentro il servizio, risultati in diretta
Environment=FANTA_MAIL=spento
Environment=FANTA_PIANIFICATORE=0
Environment=FANTA_REGISTRO_GIORNATE=0
Environment=FANTA_COPIA_SCADENZA=0
Environment=FANTA_RISCALDA=0
Environment=FANTA_LIVE=0
# spente tutte le fonti di dati esterne: i dati di calcio arrivano solo dalla copia notturna della produzione.
# Nessun canale di avvisi e nessuna casella di posta: non vanno aggiunti.
Environment=FANTA_FONTE_FANTACALCIO=0
Environment=FANTA_FONTE_UNDERSTAT=0
Environment=FANTA_FONTE_FOOTBALLDATA=0
Environment=FANTA_FONTE_ESPN=0
Environment=FANTA_FONTE_FOTO=0
# risorse: la prova cede sempre il passo alla produzione
Nice=19
CPUWeight=20
MemoryMax=500M
# recinto
ProtectSystem=strict
ProtectHome=tmpfs
ReadWritePaths=/srv/schieraxi-prova/app/dati
InaccessiblePaths=-/etc/schieraxi-prova -/srv/schieraxi-prova/.cache -/srv/schieraxi-prova/schieraxi-src -/srv/schieraxi-scambio
ProtectProc=invisible
PrivateTmp=yes
NoNewPrivileges=yes
IPAddressAllow=localhost
IPAddressDeny=any
# le stesse righe del recinto della produzione (sicurezza.conf del servizio fantacalcio): niente kernel, moduli, log del kernel,
# orologio, dispositivi, cgroup; niente privilegi (CapabilityBoundingSet vuoto), setuid, spazi dei nomi, tempo reale; solo IPv4, IPv6
# e socket locali; in /proc solo i processi
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
PrivateDevices=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true
SystemCallArchitectures=native
ProcSubset=pid
CapabilityBoundingSet=
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target

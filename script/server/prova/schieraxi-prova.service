# Servizio systemd dell'AMBIENTE DI PROVA di SchieraXI (script/server/prova/LEGGIMI.md, passo 4.4): una seconda copia dell'app,
# con dati inventati, accanto alla produzione. Da copiare in /etc/systemd/system/schieraxi-prova.service sostituendo <utente>.
# Ascolta solo su 127.0.0.1:8001: dall'esterno ci si arriva da nginx (nginx-prova.conf.esempio).
#
# Chiuso nella sua cartella. ProtectHome=tmpfs mette al posto di /home una cartella vuota: il servizio vede solo ~/schieraxi-prova
# (in sola lettura) e ci scrive solo in ~/schieraxi-prova/dati. Non vede i dati, la lega e le copie della produzione, la chiave delle
# firme, il canale degli avvisi, le chiavi ssh. InaccessiblePaths ripete i posti piu' delicati: e' la seconda rete se un giorno
# ProtectHome torna "read-only" (il '-' davanti vuol dire "se c'e'"). Memoria e processore limitati: la produzione ha la precedenza.
# Serve un Python fuori da /home per l'ambiente (passo 4.1: readlink -f ~/fantacalcio/.venv/bin/python) e systemd 238 o piu' nuovo.
[Unit]
Description=SchieraXI - ambiente di prova (dati inventati)
After=network-online.target
Wants=network-online.target

[Service]
User=<utente>
WorkingDirectory=/home/<utente>/schieraxi-prova
# senza '-' davanti: se il file manca il servizio non parte (senza, posta e lavori periodici sarebbero accesi)
EnvironmentFile=/home/<utente>/schieraxi-prova/dati/ambiente.env
ExecStart=/home/<utente>/schieraxi-prova/.venv/bin/python -m fanta server --host 127.0.0.1 --porta 8001
Restart=on-failure
RestartSec=5
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=FANTA_MULTIUTENTE=1
# risorse: la prova cede sempre il passo alla produzione
Nice=19
CPUWeight=20
MemoryMax=500M
# isolamento
ProtectSystem=strict
ProtectHome=tmpfs
BindReadOnlyPaths=/home/<utente>/schieraxi-prova
BindPaths=/home/<utente>/schieraxi-prova/dati
ReadWritePaths=-/home/<utente>/schieraxi-prova/dati
InaccessiblePaths=-/home/<utente>/fantacalcio -/home/<utente>/backup-dati -/home/<utente>/.config -/home/<utente>/.ssh
PrivateTmp=yes
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target

{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *:refs/heads/main*)",
      "Bash(git -C * push * main)",
      "Bash(git -C * push * main *)",
      "Bash(git -C * push *:main*)",
      "Bash(git push --force*)",
      "Bash(git push *--force*)",
      "Bash(git push -f *)",
      "Bash(git push * -f)",
      "Bash(git push * -f *)",
      "Bash(git push * +*)",
      "Bash(git -C * push *--force*)",
      "Bash(git -C * push * -f*)",
      "Bash(git -C * push * +*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git commit -n *)",
      "Bash(git commit * -n)",
      "Bash(git commit * -n *)",
      "Bash(git -C * commit *--no-verify*)",
      "Bash(git -C * commit * -n*)"
    ]
  }
}
